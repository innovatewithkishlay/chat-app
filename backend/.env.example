# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/chat-app

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Redis (status feed caching, login rate limiting, password reset rate limiting)
REDIS_URL=redis://localhost:6379

# Resend (password reset emails) — https://resend.com, free tier available.
# Without this, reset links are logged to the server console instead of
# emailed - fine for local dev, not for production. The sandbox sender
# (default, no RESEND_FROM_EMAIL set) only delivers to the email address
# your Resend account itself is registered with, until you verify a domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudinary (image & video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Pro subscriptions)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Web Push (VAPID) — generate with `npm run generate:vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# TURN relay for WebRTC calls (optional). Without this, calls only use public
# STUN servers, which fails to connect for some peers behind restrictive/
# symmetric NATs (common on mobile data or corporate wifi). Get credentials
# from a provider (Twilio Network Traversal, Metered.ca, etc.) or run your
# own coturn server. TURN_URLS accepts a comma-separated list.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
