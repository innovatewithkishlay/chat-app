# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/chat-app

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Redis (status feed caching, login rate limiting, password reset rate limiting)
REDIS_URL=redis://localhost:6379

# Gmail SMTP (password reset emails). Without this, reset links are logged
# to the server console instead of emailed - fine for local dev, not for
# production. GMAIL_APP_PASSWORD must be an App Password (16 characters, no
# spaces), not your normal Gmail password - generate one at
# myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cloudinary (image & video uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Pro subscriptions)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Web Push (VAPID) — generate with `npm run generate:vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# TURN relay for WebRTC calls (optional, but effectively required for calls
# to reliably work between two peers on different networks - e.g. two
# phones on different mobile carriers). Without one, calls only use public
# STUN servers, which frequently isn't enough to traverse NAT on both ends.
#
# Metered.ca (free tier available) - sign up, create an app, open its TURN
# Server page, and use the domain + API key shown there:
METERED_DOMAIN=
METERED_API_KEY=

# Or a static TURN provider (Twilio Network Traversal, self-hosted coturn,
# etc.) - used only if the Metered vars above aren't set. TURN_URLS accepts
# a comma-separated list.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
